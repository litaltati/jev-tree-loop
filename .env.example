# OpenAI: the agents of the Jev loop and the Excel parsing — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# TypeSafe: Jev, for the tree and the loop — https://console.typesafe.ai/keys
# Without it the tree is off and code takes the loop's steps (the SQL agent once, then the answer).
TYPESAFE_API_KEY=

# The model that describes the sheets while parsing
PARSER_AGENT_MODEL_DESCRIBE=gpt-4o-mini
# No anonymous usage statistics from CrewAI
CREWAI_DISABLE_TELEMETRY=true

# Uncomment to switch the Jev tree off: then the Jev loop answers every question (to compare)
# PARSER_AGENT_JEV_TREE=off

# Langfuse (optional): `python3 langfuse/init_env.py` appends LANGFUSE_PUBLIC_KEY,
# LANGFUSE_SECRET_KEY and LANGFUSE_BASE_URL below. Traces go under this environment.
LANGFUSE_TRACING_ENVIRONMENT=jev-tree
